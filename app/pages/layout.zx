pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en">
            <head>
                <title>Zig World Map</title>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <link rel="preload" href="/locations.json?v=1" as="fetch" crossorigin="anonymous" />
                <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.css" />
                <script src="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.js"></script>
                <script src="/assets/basemap.js?v=1"></script>
            </head>
            <body>
                {children}
            </body>
        </html>
    );
}

const zx = @import("zx");
